{
  "description": "Edge URL Shortener and Analytics, runs on Cloudflare Workers and D1, live at go.avenash-kumar.com",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.72.0",
    "@playwright/test": "^1.49.0"
  },
  "name": "edge-url-shortener",
  "private": true,
  "scripts": {
    "db:create": "wrangler d1 create edge-url-shortener",
    "db:migrate:local": "wrangler d1 migrations apply edge-url-shortener --local",
    "db:migrate:remote": "wrangler d1 migrations apply edge-url-shortener --remote",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "type": "module",
  "version": "0.1.0"
}
